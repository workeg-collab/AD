{
  "buildCommand": null,
  "outputDirectory": "build/web",
  "cleanUrls": false,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cleanup-old-files",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
